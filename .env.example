# =============================================================================
# Cerigatto — variáveis de ambiente
# Copie para .env.local (nunca versionado) e preencha.
# =============================================================================

# URL pública do site (sem barra no final). Usada em SEO, sitemap e links do WhatsApp.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API). A chave publicável é segura no navegador
# porque todo acesso é protegido por Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SOMENTE SERVIDOR. Necessária apenas para convidar administradores pelo painel
# e para o script `pnpm admin:create`. Nunca use prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Sal usado para gerar hashes anônimos de IP no rate limit (string aleatória longa).
RATE_LIMIT_SALT=

# Modo demonstração: quando "true" E o Supabase não estiver configurado, o site
# usa os dados fictícios de supabase/seed/demo-data.ts (somente leitura).
# Útil para avaliar o layout e rodar os testes E2E sem banco. Não use em produção.
CERIGATTO_DEMO_MODE=false

# Analytics (opcional). Também podem ser definidos no painel em Configurações.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
